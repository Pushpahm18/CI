# Copy to .env.local for local development. Never commit real values.
# Names match src/auth.ts, src/server/entra-users.ts and app.yaml.

# --- Auth.js (required) ---------------------------------------------------
# Signs/encrypts the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Only needed when deployed behind a fixed public URL (see app.yaml).
# AUTH_URL=

# --- Microsoft Entra ID (real Microsoft login) ------------------------------
# From the CI app's Entra App Registration. Leave blank until available.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Local UI development only ------------------------------------------------
# true  -> "Sign in with Microsoft" signs in a fake "Local Dev User" and skips
#          the Databricks access check. Only works under `npm run dev`
#          (NODE_ENV=development); ignored by `next build`/`npm run start`.
# false -> real Microsoft Entra ID sign-in (requires the AZURE_* values above).
DEV_MOCK_AUTH=false

# Optional local sign-in identity for DEV_MOCK_AUTH (role still comes from User Management).
# DEV_MOCK_AUTH_EMAIL=
# DEV_MOCK_AUTH_NAME=

# There is no mock or sample-data mode: a screen whose CI Databricks table has no
# configuration yet shows "CI database table configuration is pending" instead.

# --- Databricks SQL warehouse (used once the CI tables exist) -------------------
# Read only on the server (src/server/db/warehouse.ts, src/server/config.ts).
# There are NO defaults: if these are missing, warehouse access fails instead
# of connecting anywhere else. In a Databricks App, set them in the app's
# environment/secrets; the platform injects the client id/secret and forwards
# each signed-in user's token. The CI catalog/schema/table names are set in
# src/server/db/schema.ts once they are known.
# DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
# DATABRICKS_WAREHOUSE_ID=            (or DATABRICKS_WAREHOUSE_HTTP_PATH=/sql/1.0/warehouses/<id>)
# DATABRICKS_TOKEN=                   (local testing only)
# DATABRICKS_CLIENT_ID=               (service principal OAuth, instead of a token)
# DATABRICKS_CLIENT_SECRET=

# --- User Management on the shared table corp_marketing_dev.samba.samba_usermanagement ---
# Server-only switches, both OFF unless set to exactly "true". Leave them off
# until each step is explicitly approved.
# Reads (User Management lists; SELECT only):
# CI_SAMBA_REFERENCE_READS=true
# Writes (Add / Edit / Delete; also requires the reads switch). Every write
# changes the table SAMBA uses for access, so SAMBA users are affected:
# CI_USER_MANAGEMENT_WRITES=true
